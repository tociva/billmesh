DB_HOST=localhost
DB_PORT=5433
DB_NAME=billmesh
DB_USER=billmesh
DB_PASSWORD=testpassword
DB_SSLMODE=disable
OIDC_ISSUER=https://hydra-dev.idnest.cloud/
OIDC_AUDIENCE=billmesh
HTTP_ADDR=:5001
RAZORPAY_BASE_URL=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_CHECKOUT_URL=
RAZORPAY_WEBHOOK_SECRET=

# Browser BFF / IdNest confidential clients. The API origin owns both opaque
# browser sessions and permits credentialed CORS only from these app origins.
CONSOLE_APP_ORIGIN=https://console-local.billme.sh
ADMIN_APP_ORIGIN=https://admin-local.billme.sh
BFF_CONSOLE_ISSUER=https://hydra-dev.idnest.cloud/
BFF_CONSOLE_CLIENT_ID=billmesh-console-bff-local
BFF_CONSOLE_CLIENT_SECRET=replace-with-idnest-console-client-secret
BFF_CONSOLE_AUDIENCE=billmesh
BFF_CONSOLE_SCOPE=openid profile email offline_access
BFF_CONSOLE_REDIRECT_URI=https://api-local.billme.sh/api/v1/auth/console/callback
BFF_CONSOLE_POST_LOGOUT_REDIRECT_URI=https://api-local.billme.sh/api/v1/auth/console/logout/callback
BFF_CONSOLE_STANDALONE_LOGOUT_URI=https://auth-local.idnest.cloud/logout
BFF_ADMIN_ISSUER=https://hydra-dev.idnest.cloud/
BFF_ADMIN_CLIENT_ID=billmesh-admin-bff-local
BFF_ADMIN_CLIENT_SECRET=replace-with-idnest-admin-client-secret
BFF_ADMIN_AUDIENCE=billmesh
BFF_ADMIN_SCOPE=openid profile email offline_access billing:admin
BFF_ADMIN_REDIRECT_URI=https://api-local.billme.sh/api/v1/auth/admin/callback
BFF_ADMIN_POST_LOGOUT_REDIRECT_URI=https://api-local.billme.sh/api/v1/auth/admin/logout/callback
BFF_ADMIN_STANDALONE_LOGOUT_URI=https://auth-local.idnest.cloud/logout
BFF_SESSION_ENCRYPTION_KEYS=v1:replace-with-base64url-encoded-32-byte-key
