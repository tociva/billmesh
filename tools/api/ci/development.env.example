# Copy to the ignored tmp/development.env and replace every placeholder.
AWS_ACCOUNT_ID=<12-digit-account-id>
AWS_REGION=ap-south-1
AWS_BUILD_ROLE_ARN=arn:aws:iam::<account-id>:role/<build-role>
AWS_DEPLOY_ROLE_ARN=arn:aws:iam::<account-id>:role/<deploy-role>
ECR_REPOSITORY=billmesh/api
KUBE_NAMESPACE=billmesh-development
API_HOSTNAME=api-dev.billme.sh
KUBERNETES_ACCESS_HOSTNAME=k8s-tociva-dev.tociva.com
KUBECONFIG_BASE64=<base64-restricted-kubeconfig>
CLOUDFLARE_ACCESS_CLIENT_ID=<service-token-id>.access
CLOUDFLARE_ACCESS_CLIENT_SECRET=<service-token-secret>

DATABASE_URL=postgres://<runtime-user>:<password>@<host>:5432/billmesh?sslmode=verify-full&search_path=billmesh
DELEGATION_ISSUER=https://auth-dev.idnest.cloud/delegation
DELEGATION_DISCOVERY_URL=https://auth-dev.idnest.cloud/.well-known/idnest-delegation-configuration
DELEGATION_AUDIENCE=https://api-dev.billme.sh
DELEGATION_PROFILE_REFRESH_INTERVAL=10s
DELEGATION_PROFILE_MAX_STALENESS=1m
WORKER_INTERVAL=1s

CONSOLE_APP_ORIGIN=https://console-dev.billme.sh
ADMIN_APP_ORIGIN=https://admin-dev.billme.sh
BFF_CONSOLE_ISSUER=https://hydra-dev.idnest.cloud/
BFF_CONSOLE_CLIENT_ID=<console-client-id>
BFF_CONSOLE_CLIENT_SECRET=<console-client-secret>
BFF_CONSOLE_AUDIENCE=billmesh
BFF_CONSOLE_SCOPE=openid profile email offline_access
BFF_CONSOLE_REDIRECT_URI=https://api-dev.billme.sh/api/v1/auth/console/callback
BFF_CONSOLE_POST_LOGOUT_REDIRECT_URI=https://api-dev.billme.sh/api/v1/auth/console/logout/callback
BFF_CONSOLE_STANDALONE_LOGOUT_URI=https://auth-dev.idnest.cloud/logout
BFF_ADMIN_ISSUER=https://hydra-dev.idnest.cloud/
BFF_ADMIN_CLIENT_ID=<admin-client-id>
BFF_ADMIN_CLIENT_SECRET=<admin-client-secret>
BFF_ADMIN_AUDIENCE=billme.sh-admins
BFF_ADMIN_SCOPE=openid profile email offline_access
BFF_ADMIN_REDIRECT_URI=https://api-dev.billme.sh/api/v1/auth/admin/callback
BFF_ADMIN_POST_LOGOUT_REDIRECT_URI=https://api-dev.billme.sh/api/v1/auth/admin/logout/callback
BFF_ADMIN_STANDALONE_LOGOUT_URI=https://auth-dev.idnest.cloud/logout
BFF_SESSION_ENCRYPTION_KEYS=<key-id>:<base64url-32-byte-key>

# Configure all five Razorpay values together, or omit all five.
# RAZORPAY_BASE_URL=https://api.razorpay.com
# RAZORPAY_KEY_ID=<key-id>
# RAZORPAY_KEY_SECRET=<key-secret>
# RAZORPAY_CHECKOUT_URL=https://checkout.razorpay.com
# RAZORPAY_WEBHOOK_SECRET=<webhook-secret>

# Optional private CA Secret references already present in Kubernetes.
# POSTGRES_CA_SECRET_NAME=billmesh-postgres-ca
# POSTGRES_CA_SECRET_KEY=ca.crt
# OUTBOUND_CA_SECRET_NAME=billmesh-outbound-ca
# OUTBOUND_CA_SECRET_KEY=ca.crt
# SSL_CERT_FILE=/run/billmesh/tls/outbound-ca.crt
